{
  "env": {
    "PYTHONIOENCODING": "utf-8",
    "PYTHONUTF8": "1"
  },
  "permissions": {
    "allow": [
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "PowerShell(pytest *)",
      "PowerShell(python -m pytest *)",
      "PowerShell(git status *)",
      "PowerShell(git log *)",
      "PowerShell(git diff *)",
      "PowerShell(git show *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"${CLAUDE_PROJECT_DIR}/plans/NEXT.md\" ]; then head -c 2000 \"${CLAUDE_PROJECT_DIR}/plans/NEXT.md\"; fi",
            "timeout": 10,
            "statusMessage": "Loading latest handoff pointer"
          }
        ]
      }
    ]
  }
}
